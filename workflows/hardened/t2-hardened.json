        "jsCode": "const src = $('H1 Intake Guard').first().json;\nconst inp = $input.first().json || {};\nconst err = inp.error_code ? inp : {};\nconst raw = err.error_message || (inp.error && (inp.error.message || inp.error)) || 'external call failed';\nreturn [{ json: { run_id: src.run_id || '', input_ref: src.input_ref || '', stage: err.error_stage || 'external',\n  node: err.error_node || 'external call', code: err.error_code || 'error:external', message: String(raw).slice(0, 300),\n  capped: err.capped ? 1 : 0 } }];"
