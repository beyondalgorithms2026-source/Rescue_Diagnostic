    },
    {
      "parameters": {
        "jsCode": "// NORM-BEGIN — ARCHITECTURE §3.5; tests/test_hardened.py runs the §3.5 vectors on this block under node.\nconst SUFFIXES = new Set(['ltd', 'limited', 'llc', 'inc', 'incorporated', 'plc', 'gmbh', 'ag', 'sa', 'sas', 'sarl',\n  'srl', 'bv', 'nv', 'co', 'corp', 'corporation', 'company']);\nfunction invoiceNoNorm(value) {\n  if (value === null || value === undefined) return '';\n  return String(value).normalize('NFKC').trim().toUpperCase().replace(/\\s+/gu, '');\n}\nfunction vendorNorm(value) {\n  if (value === null || value === undefined) return '';\n  const text = String(value).normalize('NFKC').toLowerCase().replace(/&/g, 'and')\n    .replace(/[^\\p{L}\\p{N}]+/gu, ' ').trim();\n  const parts = text ? text.split(' ') : [];\n  while (parts.length && SUFFIXES.has(parts[parts.length - 1])) parts.pop();\n  return parts.join(' ');\n}\nfunction dedupeKey(invoiceNo, vendor, currency) {\n  const a = invoiceNoNorm(invoiceNo), b = vendorNorm(vendor);\n  if (!a || !b || !currency) return '';\n  return a + '|' + b + '|' + currency;\n}\n// NORM-END\n\nconst src = $('H7 Cost Ledger Record').first().json;\nconst isNum = (v) => typeof v === 'number' && Number.isFinite(v);\nconst reject = (message) => [{ json: { ...src, route: 'reject', error_stage: 'validate', error_node: 'H8 Schema Gate',\n  error_code: 'reject:schema', error_message: message, terminal_status: 'rejected' } }];\nlet data;\ntry { data = JSON.parse(src.extracted_json || ''); } catch (error) { return reject('model output is not json'); }\nif (!data || typeof data !== 'object' || Array.isArray(data)) return reject('model output is not an object');\nif (typeof data.invoice_no !== 'string' || !data.invoice_no.trim()) return reject('invoice_no missing');\nif (typeof data.vendor !== 'string' || !data.vendor.trim()) return reject('vendor missing');\nif (!isNum(data.total)) return reject('total missing or not a number');\nif (!Array.isArray(data.line_items) || data.line_items.length === 0) return reject('line_items empty');\nif (data.line_items.some((line) => !line || !isNum(line.line_total))) return reject('line_total missing');\nfor (const key of ['subtotal', 'tax']) {\n  if (data[key] !== null && data[key] !== undefined && !isNum(data[key])) return reject(key + ' is not a number');\n}\n// H9 foot check, in cents.\nconst cents = (v) => Math.round(Number(v) * 100);\nconst lineSum = data.line_items.reduce((sum, line) => sum + cents(line.line_total), 0);\nconst subtotal = isNum(data.subtotal) ? cents(data.subtotal) : lineSum;\nconst tax = isNum(data.tax) ? cents(data.tax) : 0;\nconst reasons = [];\nif (Math.abs(lineSum - subtotal) > 1) reasons.push('line totals do not equal subtotal');\nif (Math.abs(subtotal + tax - cents(data.total)) > 1) reasons.push('subtotal plus tax does not equal total');\nconst currency = ['USD', 'EUR', 'GBP'].includes(data.currency) ? data.currency : null;\nif (!currency) reasons.push('currency missing or not USD, EUR, GBP');\nif (!data.invoice_date || !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(data.invoice_date))) reasons.push('invoice_date missing or not ISO');\nconst formCurrency = String(src.form_currency || '').split('—')[0].trim().toUpperCase();\nif (currency && formCurrency && formCurrency !== currency) reasons.push('form currency differs from document');\nconst key = dedupeKey(data.invoice_no, data.vendor, currency);\nif (!key) reasons.push('no dedupe key');\nreturn [{ json: { ...src, pdf_text: undefined, invoice: { ...data, currency }, vendor_norm: vendorNorm(data.vendor),\n  dedupe_key: key, route: reasons.length ? 'review' : 'act', review_reason: reasons.join('; ') } }];\n"
      },
