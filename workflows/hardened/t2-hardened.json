    {
      "parameters": {
        "jsCode": "const done = (name) => { try { return $(name).isExecuted; } catch (error) { return false; } };\nconst pick = (name) => (done(name) ? $(name).first().json : {});\nconst intake = pick('H1 Intake Guard');\nconst gate = pick('H8 Schema Gate');\nconst cost = pick('H7 Cost Ledger Record');\nconst error = pick('E Build Error Record');\nlet status = 'duplicate_skip';\nlet stage = 'intake';\nif (done('E Build Error Record')) { status = String(error.code || '').startsWith('reject') ? 'rejected' : 'error'; stage = error.stage || 'record'; }\nelse if (done('H13 Header Append')) { status = 'committed'; stage = 'act'; }\nelse if (done('H15 Review Append')) { status = 'review'; stage = 'approve'; }\nelse if (done('H11 Dedupe Lookup')) { stage = 'act'; }\nreturn [{ json: { run_id: intake.run_id || '', input_ref: intake.input_ref || '', execution_id: String($execution.id),\n  stage, node: 'H16 Audit Record', ok: status === 'error' ? 0 : 1, status,\n  content_sha256: pick('H1 PDF SHA-256').content_sha256 || '', dedupe_key: gate.dedupe_key || '',\n  tokens_in: cost.tokens_in ?? 0, tokens_out: cost.tokens_out ?? 0, usd: cost.usd ?? 0, duration_ms: '' } }];\n"
      },
