    {
      "parameters": {
        "jsCode": "const gate = $('H8 Schema Gate').first().json;\nconst inv = gate.invoice;\nconst esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst allow = String(gate.report_recipient_allowlist || '').split(',').map((d) => d.trim().toLowerCase()).filter(Boolean);\nconst to = String(gate.submitter_email || '').trim();\nconst domain = to.includes('@') ? to.split('@').pop().toLowerCase() : '';\nconst rows = inv.line_items.map((l) => '<tr><td>' + esc(l.description) + '</td><td>' + esc(l.line_total) + '</td></tr>').join('');\nconst html = '<h1>Invoice recorded</h1><p>' + esc(inv.vendor) + ' ' + esc(inv.invoice_no) + ' ' + esc(inv.invoice_date) +\n  ' ' + esc(inv.currency) + ' ' + esc(inv.total) + '</p><table>' + rows + '</table>';\nconst subject = ('Invoice recorded ' + String(inv.invoice_no) + ' ' + String(inv.vendor)).replace(/[\\r\\n<>]/g, ' ').slice(0, 150);\nreturn [{ json: { run_id: gate.run_id, to, subject, html, send: allow.includes(domain) } }];\n"
      },
